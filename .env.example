# 실제 값은 .env.local에 넣으세요. .env.local은 .gitignore에 포함되어 커밋되지 않습니다.

# Google AI Studio / Gemini API (image-generation feature, style 1)
GEMINI_API_KEY=

# OpenAI API (image-generation feature, style 2 — gpt-image-1)
OPENAI_API_KEY=

# Anthropic Claude API (copy-recommendation feature)
ANTHROPIC_API_KEY=

# Supabase (동적 생성 이미지 저장용 Storage 버킷 — route.ts 구현 시 연결)
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
